# ── launch (blank = DRY-RUN: snapshot + accrue, send nothing) ─────────────
ROBX_TOKEN=
TREASURY_PRIVATE_KEY=
# ROBX_START_BLOCK=

# ── payouts ───────────────────────────────────────────────────────────────
# PAYOUT_TOKENS=TSLA:0x322F0929c4625eD5bAd873c95208D54E1c003b2d:3000,NVDA:0xd0601CE157Db5bdC3162BbaC2a2C8aF5320D9EEC:500,SPCX:0x4a0E65A3EcceC6dBe60AE065F2e7bb85Fae35eEa:3000
# MIN_PAYOUT_USD=1
# EPOCH_MINUTES=30
# EXCLUDE_ACCOUNTS=

# ── pons v2 (бондинг-кривая -> graduation) ────────────────────────────────
# Комиссия создателя копится в эскроу в НАТИВНОМ ETH; кипер её клеймит и
# заворачивает в WETH. Пустое значение выключает шаг.
# PONS_FEE_ESCROW=0xd3AFEB2a57f70eF218Aa82451c51B2fb0416Ac9e
# GAS_RESERVE_ETH=0.01     # столько ETH никогда не заворачивается - это газ
# MIN_CLAIM_ETH=0.0005     # меньше этого клеймить не стоит

# ── service ───────────────────────────────────────────────────────────────
# STATE_DIR=/data          # Railway: mount a Volume here
# ALLOW_ORIGIN=https://robinx.tech
# RPC_URL=https://rpc.mainnet.chain.robinhood.com
# PERPS_ENABLED=true
